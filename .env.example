DB_HOST=db
DB_NAME=naser_sgi_prueba
DB_USER=naser
DB_PASS=naser2026
DB_ROOT_PASS=root2026
APP_BASE=

# dev = muestra errores y la cuenta demo en el login
# production = oculta errores (quedan en logs/php-errors.log)
APP_ENV=dev

# URL con la que se entra al sistema (se usa en los links de los mails)
APP_URL=http://localhost:8080

# ---------- MAILS ----------
# En desarrollo los mails van a Mailpit: abrir http://localhost:8025 para verlos.
# En produccion, completar con el SMTP real (ej: el de gruponaser.com.ar):
# MAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.gruponaser.com.ar
# SMTP_PORT=587
# SMTP_SECURE=tls
# SMTP_USER=sgi@gruponaser.com.ar
# SMTP_PASS=********
MAIL_FROM=sgi@gruponaser.com.ar
MAIL_FROM_NAME=NASER SGI

# ---------- BACKUPS ----------
# Hora del backup diario (0-23) y cuantos dias se guardan
BACKUP_HORA=2
BACKUP_DIAS=7

# ---------- ACCESO DESDE INTERNET (Cloudflare Tunnel) ----------
# Token que da Cloudflare al crear el tunel. Con esto: docker compose --profile tunnel up -d
# Y APP_URL tiene que ser la direccion https publica (se usa en los links de los mails).
# TUNNEL_TOKEN=

# ---------- HTTPS PROPIO (Caddy, perfil "https") ----------
# Dominio publico del sistema. Con esto: docker compose --profile https up -d
# Y APP_URL tiene que ser https://<ese dominio> (se usa en los links de los mails).
# SITE_DOMAIN=sgi.gruponaser.com.ar
